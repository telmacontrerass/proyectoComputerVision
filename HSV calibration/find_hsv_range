
import cv2
import numpy as np

COLOR = "azul"  # color que queremos medir

cap = cv2.VideoCapture(0)

cv2.namedWindow("sliders")

for nombre, maximo in [
    ("H min", 179), ("H max", 179),
    ("S min", 255), ("S max", 255),
    ("V min", 255), ("V max", 255)
]:
    cv2.createTrackbar(
        nombre, "sliders",
        0 if "min" in nombre else maximo,
        maximo, lambda x: None
    )

captura = False
frame_guardado = None

# Valores iniciales
lo = np.array([0, 0, 0])
hi = np.array([179, 255, 255])


def seleccionar_color(event, x, y, flags, param):
    global lo, hi, captura

    if event == cv2.EVENT_LBUTTONDOWN and captura:
        # Seleccionar una zona de 20x20 píxeles
        hsv = cv2.cvtColor(frame_guardado, cv2.COLOR_BGR2HSV)

        x1 = max(0, x - 10)
        x2 = min(hsv.shape[1], x + 10)
        y1 = max(0, y - 10)
        y2 = min(hsv.shape[0], y + 10)

        zona = hsv[y1:y2, x1:x2]

        # Calcular límites usando percentiles
        pixeles = zona.reshape(-1, 3)

        minimo = np.percentile(pixeles, 5, axis=0)
        maximo = np.percentile(pixeles, 95, axis=0)

        # Añadir margen para tolerar variaciones
        margen = np.array([5, 40, 40])

        lo = np.maximum(minimo - margen, [0, 0, 0]).astype(int)
        hi = np.minimum(maximo + margen, [179, 255, 255]).astype(int)

        # Actualizar sliders
        for nombre, valor in zip(
            ("H min", "S min", "V min"), lo
        ):
            cv2.setTrackbarPos(nombre, "sliders", int(valor))

        for nombre, valor in zip(
            ("H max", "S max", "V max"), hi
        ):
            cv2.setTrackbarPos(nombre, "sliders", int(valor))

        captura = False
        print("Color seleccionado:")
        print("Lower:", lo.tolist())
        print("Upper:", hi.tolist())


cv2.namedWindow("camara")
cv2.setMouseCallback("camara", seleccionar_color)

while True:

    if not captura:
        ok, frame = cap.read()
        if not ok:
            break
    else:
        frame = frame_guardado.copy()

    if not captura:
        frame_guardado = frame.copy()

    hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)

    # Leer sliders
    lo = np.array([
        cv2.getTrackbarPos(n, "sliders")
        for n in ("H min", "S min", "V min")
    ])

    hi = np.array([
        cv2.getTrackbarPos(n, "sliders")
        for n in ("H max", "S max", "V max")
    ])

    mask = cv2.inRange(hsv, lo, hi)

    resultado = cv2.bitwise_and(frame, frame, mask=mask)

    cv2.imshow("camara", frame)
    cv2.imshow("mascara", resultado)

    tecla = cv2.waitKey(1) & 0xFF

    # C = congelar imagen para seleccionar color
    if tecla == ord("c"):
        captura = True
        print("Imagen congelada. Haz clic sobre el color que quieres detectar.")

    # R = volver a la cámara
    elif tecla == ord("r"):
        captura = False

    # Q = salir e imprimir valores
    elif tecla == ord("q"):
        print(f"{COLOR}: lower={lo.tolist()}, upper={hi.tolist()}")
        break

cap.release()
cv2.destroyAllWindows()
